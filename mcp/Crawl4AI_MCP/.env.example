# Copy to .env and adjust. Every variable below is optional — the defaults
# shown are the ones baked into app/config.py.

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.2

# ── Storage ──────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
SQLITE_DB_PATH=./data/research.db

# ── Crawling ─────────────────────────────────────────────────────────────────
MAX_CONCURRENT_CRAWLS=5
PAGE_TIMEOUT_MS=30000
# Options: enabled | bypass | disabled
CACHE_MODE=enabled

# ── Content quality ──────────────────────────────────────────────────────────
PRUNING_THRESHOLD=0.45
BM25_THRESHOLD=1.0
MIN_WORD_THRESHOLD=50

# ── Chunking: token budget (used for pre-embedding truncation) ───────────────
# EMBED_MODEL_MAX_TOKENS: hard context-window limit of the embedding model.
# EMBED_TOKENIZER_SAFETY_FACTOR: accounts for the token-count difference between
#   tiktoken cl100k_base (used to measure/truncate) and the BERT-style tokenizers
#   used by Ollama embed models. Typical prose ~1.33x; URL-dense/minified ~1.8x.
# CHUNK_SIZE_TOKENS is auto-derived when not set:
#   floor(EMBED_MODEL_MAX_TOKENS * EMBED_TOKENIZER_SAFETY_FACTOR / 8) * 8
#   default: floor(512 * 0.6 / 8) * 8 = 304
EMBED_MODEL_MAX_TOKENS=512
EMBED_TOKENIZER_SAFETY_FACTOR=0.6
# CHUNK_SIZE_TOKENS=304        # set to override the auto-derived value
# CHUNK_OVERLAP_TOKENS is legacy/unused — overlap is set via CHUNK_OVERLAP_WORDS below.
CHUNK_OVERLAP_TOKENS=40

# ── Chunking: Crawl4AI native strategy (the primary chunking path) ───────────
# CHUNKING_STRATEGY: sliding_window (default) | regex | overlapping
CHUNKING_STRATEGY=sliding_window
# Word-based window (sliding_window + overlapping)
CHUNK_WINDOW_SIZE_WORDS=200
# Step in words between windows (sliding_window only)
CHUNK_STEP_SIZE_WORDS=160
# Overlap in words between windows (overlapping only)
CHUNK_OVERLAP_WORDS=40
# Comma-separated regex patterns (regex strategy only), e.g. "\n\n,\n###"
REGEX_CHUNKING_PATTERNS=\n\n

# ── LLM extraction (opt-in) ──────────────────────────────────────────────────
# When true, LLMExtractionStrategy produces semantically richer chunks during
# the crawl. Can also be toggled per-call via the use_llm_extraction tool arg.
LLM_EXTRACTION_ENABLED=false