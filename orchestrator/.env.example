# ── Ollama / models ───────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Primary reasoning model (one hot model, role-prompted per agent).
REASONING_MODEL=qwen2.5:14b-instruct-q4_K_M
# Fallback if 14B + context won't fit the 16 GB VRAM envelope.
REASONING_MODEL_FALLBACK=llama3.1:8b-instruct-q5_K_M
# Must match the embedding model the crawl4ai MCP uses for ChromaDB.
EMBED_MODEL=nomic-embed-text
MODEL_CONTEXT_TOKENS=8192
MODEL_KEEP_ALIVE=-1

# ── crawl4ai MCP ────────────────────────────────────────────────────────────
MCP_SERVER_CWD=../mcp/Crawl4AI_MCP

# ── Storage / artifacts ─────────────────────────────────────────────────────
SESSIONS_DIR=./data/sessions
REPORTS_DIR=./data/reports

# ── Research loop / stop-rule ───────────────────────────────────────────────
MAX_ITERATIONS_PER_SUBTOPIC=4
MIN_NEW_CLAIMS=2

# ── Verification ────────────────────────────────────────────────────────────
INDEPENDENCE_COSINE_THRESHOLD=0.92
# Publication-date gap (months) at/above which a contradiction is temporal_drift, not factual.
TEMPORAL_DRIFT_THRESHOLD_MONTHS=18

# ── Adaptive depth → target evidence per subtopic ───────────────────────────
TARGET_EVIDENCE_SHALLOW=2
TARGET_EVIDENCE_NORMAL=3
TARGET_EVIDENCE_DEEP=5